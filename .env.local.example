# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.local.example is checked in as a template.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — REQUIRED ONLY for running scripts/migrate-to-supabase.js.
# DO NOT expose this to the browser. Never commit it. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
