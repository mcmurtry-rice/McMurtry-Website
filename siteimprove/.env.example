# Copy this file to siteimprove/.env and fill in real values.
# The .env file is gitignored and must never be committed.

# Your Siteimprove login email (the user the API key is associated with).
SITEIMPROVE_USERNAME=your.email@rice.edu

# The API key generated under Settings > Integrations > API > API Keys.
SITEIMPROVE_API_KEY=replace-with-real-key

# Optional. If left blank, the fetcher resolves the site by host.
# SITEIMPROVE_SITE_ID=

# The site to fetch. Defaults to mcmurtry.rice.edu.
SITEIMPROVE_SITE_HOST=mcmurtry.rice.edu

# "us" (default) or "eu" — controls which Siteimprove region the API hits.
SITEIMPROVE_REGION=us

# Max items per page. Siteimprove allows up to 1000.
SITEIMPROVE_PAGE_SIZE=1000

# Cap on how many accessibility issues to drill into for affected pages.
# Set high enough to cover everything; lower to speed up dev runs.
SITEIMPROVE_MAX_DETAIL_ISSUES=200

# --- scrape-dashboard.js (Playwright/CDP fallback) ---

# CDP endpoint of an already-running Chrome (launched with
# --remote-debugging-port=9222). Used when you can't get an API key and have
# to scrape the dashboard UI directly.
SITEIMPROVE_CDP_URL=http://localhost:9222

# Substring used to find your Siteimprove tab. Default works for any
# my2.us.siteimprove.com or my2.eu.siteimprove.com tab.
SITEIMPROVE_TAB_URL=siteimprove.com

# Max page size to set per table (Siteimprove caps at 200).
SITEIMPROVE_TABLE_PAGE_SIZE=200
