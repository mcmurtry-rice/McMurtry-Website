.go-to-hyper {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  max-height: 500px;
  margin-top: 20px;
  padding-top: 125.29%;
}

.go-to-hyper > div {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
}

.go-to-hyper img {
  width: 100%;
  display: block;
}

.go-to-hyper__image {
  position: absolute;
  left: 0;
  bottom: 100%;
  animation: slide-hyper-image;
  animation-fill-mode: forwards;
  animation-duration: 30s;
  z-index: -1;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  transform: translateY(calc(0% + 479px));
}

@keyframes slide-hyper-image {
  from {
    transform: translateY(calc(100% - 0px));
  }
  to {
    transform: translateY(calc(0% + 479px));
  }
}

